# Valleytainment Visual Brain — Godot 4 performance engine
config_version=5

[application]
config/name="Valleytainment Visual Brain"
config/description="AI visual performance instrument for EDM"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.svg"

[display]
window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[network]
limits/debugger/max_chars_per_second=32768

[rendering]
anti_aliasing/quality/msaa_2d=2
environment/defaults/default_clear_color=Color(0.02, 0.02, 0.05, 1)
